# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# HackerOne API Credentials (REQUIRED)
TOKEN_NAME=your_hackerone_token_name
TOKEN_VALUE=your_hackerone_token_value

# Slack Bot Credentials (REQUIRED)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Eraser API Credentials (REQUIRED for diagram generation)
ERASER_API_KEY=your_eraser_api_key_if_needed

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Authorization - Comma-separated list of Slack user IDs
AUTHORIZED_USERS=U123456789,U987654321,U555666777

# Channel Restrictions - Bot will only respond in these channels
ALLOWED_CHANNELS=#channel1,#channel2,#channel3

# =============================================================================
# ORGANIZATION CONFIGURATION
# =============================================================================

# Organization Details - Customize for your organization
ORGANIZATION_NAME=YourOrg
ORGANIZATION_SECURITY_TEAM_NAME=YourOrg Security Team
ORGANIZATION_DOMAINS=yourorg.com
ORGANIZATION_PROGRAMS=yourorg:PUBLIC
ORGANIZATION_PROGRAM_PATTERNS=YourOrg\\.com

# Bot Identity Configuration
BOT_NAME=H1 Analyst Agent
BOT_RESTRICTION_MESSAGE_TEMPLATE=This {bot_name} is RESTRICTED to authorized {security_team} members only
BOT_CONTACT_MESSAGE_TEMPLATE=If you believe you should have access, please contact the {security_team} directly
BOT_UNAUTHORIZED_ACCESS_MESSAGE=UNAUTHORIZED ACCESS - {security_team} Only

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Logging
LOG_LEVEL=INFO
SLACK_BOT_ID=U123456789
SLACK_BOT_TYPE=security_analyst

# Application Configuration
MAX_FOLLOWUP_OPTIONS=3
API_TIMEOUT=90
ERASER_API_TIMEOUT=180

# =============================================================================
# API URLS AND ENDPOINTS (using defaults - can be overridden if needed)
# =============================================================================

# API URLs and Endpoints - using secure defaults
# HACKERONE_API_BASE_URL=https://api.hackerone.com/v1
# HACKERONE_WEB_BASE_URL=https://hackerone.com
# HACKERONE_DEFAULT_AVATAR_URL=https://www.hackerone.com/sites/default/files/2020-11/h1-default-avatar.jpg
# ERASER_API_BASE_URL=https://app.eraser.io/api/render/prompt
# MERMAID_LIVE_BASE_URL=https://mermaid.live/edit#pako:
# SLACK_API_BASE_URL=https://slack.com/api

# =============================================================================
# PERFORMANCE AND LIMITS (using defaults - can be overridden if needed)
# =============================================================================

# Pagination and Limits
# HACKERONE_PAGE_SIZE=100
# REPORT_ANALYTICS_TIMEOUT=30

# Text Processing Limits
# MAX_TEXT_LENGTH=3000
# MAX_CONTENT_LENGTH=2000
# URL_TRUNCATE_LENGTH=80
# PATH_TRUNCATE_LENGTH=50
# TITLE_TRUNCATE_LENGTH=100
# SHORT_TITLE_LENGTH=50

# Slack Block Management
# SLACK_MAX_BLOCKS_PER_MESSAGE=50
# SLACK_BLOCK_SAFETY_MARGIN=5

# Retry and Polling Configuration
# API_RETRY_SLEEP_SECONDS=2
# DIAGRAM_UPLOAD_WAIT_SECONDS=15

# Security and Validation
# SUSPICIOUS_INPUT_MIN_LENGTH=50
# VALIDITY_SCORE_RANGE=100

# Eraser API Configuration
# ERASER_DIAGRAM_SPACING_HORIZONTAL=80
# ERASER_DIAGRAM_SPACING_VERTICAL=80

# Severity Score Mapping (for report analytics)
# SEVERITY_SCORE_CRITICAL=2000.0
# SEVERITY_SCORE_HIGH=1000.0
# SEVERITY_SCORE_MEDIUM=500.0
# SEVERITY_SCORE_LOW=100.0
# SEVERITY_SCORE_NONE=0.0

# Logging Configuration
# LOG_SEPARATOR_LENGTH=50

# =============================================================================
# ORGANIZATION CONFIGURATION (using defaults - can be overridden if needed)
# =============================================================================

# Organization Identity
ORGANIZATION_NAME=YourOrg
ORGANIZATION_SECURITY_TEAM_NAME=YourOrg Security Team
ORGANIZATION_DOMAINS=yourorg.com
ORGANIZATION_PROGRAMS=yourorg:PUBLIC
ORGANIZATION_PROGRAM_PATTERNS=YourOrg\\.com

# Bot Identity Configuration
# BOT_NAME=H1 Analyst Agent
# BOT_RESTRICTION_MESSAGE_TEMPLATE=This {bot_name} is RESTRICTED to authorized {security_team} members only
# BOT_CONTACT_MESSAGE_TEMPLATE=If you believe you should have access, please contact the {security_team} directly
# BOT_UNAUTHORIZED_ACCESS_MESSAGE=UNAUTHORIZED ACCESS - {security_team} Only

# =============================================================================
# NOTES
# =============================================================================
# 
# Most configuration parameters above are commented out because they use
# secure defaults defined in src/config.py. Uncomment and modify any values
# you need to override for your specific environment.
#
# For development/testing, you might want to override:
# - API_TIMEOUT=120 (longer timeout for debugging)
# - LOG_LEVEL=DEBUG (more verbose logging)
#
# For production, you might want to override:
# - LOG_LEVEL=WARNING (less verbose logging)
# - API_TIMEOUT=60 (shorter timeout for faster responses)
#
# To set up your environment:
# 1. Copy this file to .env
# 2. Fill in your actual credentials for the REQUIRED fields
# 3. Update AUTHORIZED_USERS with actual Slack user IDs
# 4. Update ALLOWED_CHANNELS with your actual channel names
# 5. Uncomment and modify any optional parameters as needed
#
